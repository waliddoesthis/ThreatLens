# --- Models (LiteLLM model strings: https://docs.litellm.ai/docs/providers) ---
SMALL_MODEL=ollama_chat/llama3.1:8b
LARGE_MODEL=anthropic/claude-sonnet-4-5
# API keys used by LiteLLM for the large model (set the one you use)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OLLAMA_API_BASE=http://localhost:11434

# --- Retrieval ---
VECTOR_STORE=qdrant   # qdrant | chroma
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RERANKER_MODEL=BAAI/bge-reranker-base
USE_RERANKER=true
RERANK_FUSION=true
TOP_K_RETRIEVE=30
TOP_K_FINAL=6
CHUNK_SIZE_WORDS=220
CHUNK_OVERLAP_WORDS=40

# --- Data ---
DATA_DIR=data
NVD_API_KEY=

# --- Router ---
ROUTER_MODE=rules   # rules | always_small | always_large
ROUTER_MIN_CONFIDENCE=0.3   # best reranker score (0-1) below which the query goes to the large model

# Answer mode: pipeline (fixed retrieve-then-answer chain) | agent (model calls tools after a seeded retrieval)
ANSWER_MODE=pipeline
AGENT_MAX_STEPS=4

# Retrieval extras
GRAPH_EXPANSION=true      # exact id lookup + techniques linked from matching Sigma rules (alerts)
TRANSLATE_QUERIES=true    # search French questions in English too (one small-model call)

# Data versions: pinned (see src/threatlens/ingest/pins.py) | latest (track upstream)
DATA_PIN=pinned
