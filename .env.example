# --- Models (LiteLLM model strings: https://docs.litellm.ai/docs/providers) ---
SMALL_MODEL=ollama/llama3.1:8b
LARGE_MODEL=anthropic/claude-sonnet-4-5
# API keys used by LiteLLM for the large model (set the one you use)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OLLAMA_API_BASE=http://localhost:11434

# --- Retrieval ---
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RERANKER_MODEL=BAAI/bge-reranker-base
USE_RERANKER=true
RERANK_FUSION=true
TOP_K_RETRIEVE=30
TOP_K_FINAL=6
CHUNK_SIZE_WORDS=220
CHUNK_OVERLAP_WORDS=40

# --- Data ---
DATA_DIR=data
NVD_API_KEY=

# --- Router ---
ROUTER_MODE=rules   # rules | always_small | always_large
